{
  "name": "@clipsync/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "clipsync": "./dist/clipsync.mjs"
  },
  "scripts": {
    "build": "node build.mjs && chmod +x dist/clipsync.mjs",
    "build:binary": "node build-binary.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@clipsync/client": "*",
    "@clipsync/crypto": "*",
    "@clipsync/protocol": "*",
    "@clipsync/server": "*",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.25.12",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
