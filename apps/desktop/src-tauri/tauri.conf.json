{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipSync",
  "version": "0.1.0",
  "identifier": "et.rfh.clipsync",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev:ui",
    "beforeBuildCommand": "npm run build:ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ClipSync",
        "width": 380,
        "height": 520,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://clip.rfh.et wss://clip.rfh.et http://127.0.0.1:8787 ws://127.0.0.1:8787; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "Encrypted clipboard sync",
    "longDescription": "Tray access to your synced clipboard history."
  }
}
