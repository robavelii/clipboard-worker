{
  "name": "@clipsync/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "db:create": "wrangler d1 create clipsync",
    "db:migrate:local": "wrangler d1 migrations apply clipsync --local",
    "db:migrate": "wrangler d1 migrations apply clipsync --remote",
    "test": "vitest run",
    "typecheck": "wrangler types >/dev/null && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@clipsync/crypto": "*",
    "@clipsync/protocol": "*",
    "hono": "^4.10.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.129.0"
  }
}
