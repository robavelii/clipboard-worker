{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "clipsync",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],

  // Custom domain. Wrangler provisions the DNS record and certificate on
  // deploy, since rfh.et is a zone on this account.
  "routes": [{ "pattern": "clip.rfh.et", "custom_domain": true }],

  // Stated rather than inherited: adding a custom domain turns these off by
  // default, and a personal clipboard should have exactly one public door.
  "workers_dev": false,
  "preview_urls": false,

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  // The web UI is served as static assets from the same origin as the API,
  // so there is no CORS surface at all. /api/* must reach the Worker before
  // the SPA fallback swallows it, and so must the installers.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/install.sh", "/install.ps1"]
  },

  // The installers in scripts/ are bundled as text and served, filled in,
  // by src/routes/install.ts.
  "rules": [{ "type": "Text", "globs": ["**/*.sh", "**/*.ps1"], "fallthrough": true }],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clipsync",
      // Created with `npm run db:create`. Local dev ignores this value.
      "database_id": "7cf3f6ff-09cc-47d2-8c1a-5eeb98093956",
      "migrations_dir": "migrations"
    }
  ],

  // Encrypted image and file chunks. Only this Worker reads or writes it: the
  // bucket has no public access, so every operation it is billed for passes
  // through the budget in src/r2.ts.
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "clipsync-blobs" }],

  // Half of R2's free tier (10 GB-month, 1M Class A and 10M Class B
  // operations a month), so a month of use never leaves it. Storage is a
  // ceiling on bytes held at any moment: past it the oldest unpinned files
  // are deleted to make room. Operations are counted per UTC month and
  // refused past their budget. See decisions §26.
  "vars": {
    // Whose GitHub releases /install.sh and /install.ps1 download from.
    "RELEASES_REPO": "robavelii/clipboard-worker",
    "R2_STORAGE_BUDGET_BYTES": 5368709120,
    "R2_CLASS_A_BUDGET": 500000,
    "R2_CLASS_B_BUDGET": 5000000
  },

  // One SyncRoom per user: the fan-out point for every connected device.
  "durable_objects": {
    "bindings": [{ "name": "SYNC", "class_name": "SyncRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SyncRoom"] }],

  // Per-address limits on the unauthenticated endpoints (keyed by
  // CF-Connecting-IP; see src/limits.ts). Periods must be 10 or 60 seconds.
  "ratelimits": [
    // /api/auth/bootstrap: guessing ADMIN_SECRET.
    { "name": "STRICT_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    // Pair-code redemption, invite claims, link requests.
    { "name": "UNAUTH_LIMIT", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],

  // Hourly purge of expired, unpinned clips and their R2 objects, and of
  // uploads no clip adopted.
  "triggers": {
    "crons": ["17 * * * *"]
  }
}
