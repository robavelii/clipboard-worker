#!/bin/sh
#
# Installs a server build and switches to it, rolling back if it does not
# come up healthy. Run by CI as `sudo clipsync-deploy <tarball>`, where the
# tarball holds the contents of apps/server/dist (clipsync-server.mjs and
# web/). Installed to /usr/local/sbin by setup.sh.

set -eu

RELEASES=/opt/clipsync/releases
CURRENT=/opt/clipsync/current
KEEP=5
HEALTH=http://127.0.0.1:8787/api/health

die() { echo "clipsync-deploy: $*" >&2; exit 1; }

[ "$(id -u)" = 0 ] || die "run with sudo"
[ $# = 1 ] || die "usage: clipsync-deploy <tarball>"
tarball=$1
[ -f "$tarball" ] && [ ! -L "$tarball" ] || die "not a regular file: $tarball"

release="$RELEASES/$(date -u +%Y%m%dT%H%M%SZ)"
mkdir -p "$release"
tar -xzf "$tarball" -C "$release" --no-same-owner --no-same-permissions
[ -f "$release/clipsync-server.mjs" ] || { rm -rf "$release"; die "no clipsync-server.mjs in the tarball"; }
chown -R root:root "$release"
chmod -R a+rX,go-w "$release"

previous=$(readlink -f "$CURRENT" 2>/dev/null || true)

switch_to() {
  ln -sfn "$1" "$CURRENT.new"
  mv -T "$CURRENT.new" "$CURRENT"
  systemctl restart clipsync-server.service
}

healthy() {
  i=0
  while [ $i -lt 30 ]; do
    curl -fsS "$HEALTH" >/dev/null 2>&1 && return 0
    sleep 1
    i=$((i + 1))
  done
  return 1
}

switch_to "$release"
if ! healthy; then
  journalctl -u clipsync-server.service -n 30 --no-pager >&2 || true
  if [ -n "$previous" ] && [ -d "$previous" ]; then
    echo "clipsync-deploy: $release did not come up; rolling back to $previous" >&2
    switch_to "$previous"
  fi
  rm -rf "$release"
  exit 1
fi
echo "deployed $release"

# Keep the newest few releases, never the live one.
live=$(readlink -f "$CURRENT")
ls -1d "$RELEASES"/*/ 2>/dev/null | sed 's:/$::' | sort -r | tail -n +$((KEEP + 1)) | while read -r old; do
  [ "$old" = "$live" ] || rm -rf "$old"
done
rm -f "$tarball"
