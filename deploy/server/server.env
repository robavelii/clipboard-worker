# Settings for clipsync-server.service. Edit, then:
#   sudo systemctl restart clipsync-server

# Most bytes of encrypted files to hold; the oldest unpinned are evicted.
# Default 5 GiB.
#CLIPSYNC_STORAGE_BYTES=21474836480

# Set to enrol the first device with a secret of your choosing; otherwise one
# is generated into /var/lib/clipsync/admin-secret on first start.
#CLIPSYNC_ADMIN_SECRET=
